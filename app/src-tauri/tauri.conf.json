{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QingqiuhuSiliconForge",
  "version": "0.3.0",
  "identifier": "com.qingqiuhu.siliconforge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "青丘湖硅基工坊",
        "width": 1200,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/sign-windows.ps1",
          "%1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDOEM4NjJEQTU5MEQ4OTkKUldTWjJKQ2xMWWFNdlAyeVZxS1lMK0o0M2hvcFR3T1k2Mk9tc05IL2hXcjNSaExPOW8wWXovOUwK",
      "endpoints": [
        "https://updates.qingqiuhu.com/forge/stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
